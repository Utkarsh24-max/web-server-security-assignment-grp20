<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> | Secure Community Forum Lab</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/forum"><span class="brand-icon">S</span> Secure Community Forum</a>
  <% if (currentUser) { %>
    <div class="top-actions">
      <span>Signed in as <strong><%= currentUser.username %></strong></span>
      <form action="/logout" method="POST"><button class="btn btn-light btn-small">Log out</button></form>
    </div>
  <% } %>
</header>
<main class="container">
<% if (notice) { %><div class="notice"><%= notice %></div><% } %>
